# Получи на https://my.telegram.org → "API development tools"
API_ID=12345678
API_HASH=abcdef1234567890abcdef1234567890

# ─── AI-провайдер ────────────────────────────────────────────────────────────
# Вариант 1: Groq (РЕКОМЕНДУЕТСЯ — бесплатно, быстро)
#   Получи ключ: https://console.groq.com → API Keys
OPENAI_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=llama-3.3-70b-versatile

# Вариант 2: Локальная Ollama (нужен запущенный ollama serve)
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=llama3

# Вариант 3: OpenAI (платно)
# OPENAI_API_KEY=sk-xxxx
# OPENAI_BASE_URL=
# OPENAI_MODEL=gpt-4o-mini

# ─── Режим работы ─────────────────────────────────────────────────────────────
# AUTO   — бот пишет сам
# HYBRID — бот генерирует ответ, но не отправляет (видно в логах)
# OFF    — бот молчит
MODE=AUTO

# ─── Поведение ────────────────────────────────────────────────────────────────
REPLY_DELAY_MIN=15
REPLY_DELAY_MAX=90
SILENCE_TIMEOUT_MINUTES=60
MAX_MESSAGES_PER_HOUR=10

# ─── Web-дашборд ──────────────────────────────────────────────────────────────
WEB_ENABLED=true
WEB_PORT=8082
